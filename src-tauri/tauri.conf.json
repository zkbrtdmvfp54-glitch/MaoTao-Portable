{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAOTAO Desktop Pet",
  "mainBinaryName": "MAOTAO",
  "version": "2.0.0",
  "identifier": "studio.maotao.desktop.pet",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-web.cjs",
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "毛桃桌面宠物",
        "url": "/src/renderer/index.html",
        "width": 420,
        "height": 340,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "menu",
        "title": "毛桃桌面宠物 · 控制面板",
        "url": "/src/renderer/menu.html",
        "width": 372,
        "height": 612,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://asset.localhost; media-src 'self' asset: http://asset.localhost https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "毛桃桌面宠物",
    "longDescription": "毛桃桌面宠物 - 轻量级 3D 交互桌面小猫伴侣",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
