{
  "appId": "studio.maotao.desktop.pet",
  "productName": "MAOTAO Desktop Pet",
  "executableName": "MAOTAO",
  "compression": "maximum",
  "electronLanguages": ["zh-CN", "en-US"],
  "directories": { "output": "dist" },
  "files": [
    "src/**/*",
    "assets/pet/manifest.json",
    "assets/pet/audio/**/*",
    "assets/pet/processed/**/*",
    "assets/pet/animations/**/*",
    "assets/pet/third-party/7paws/**/*"
  ],
  "asarUnpack": ["node_modules/uiohook-napi/prebuilds/**"],
  "npmRebuild": false,
  "win": {
    "icon": "assets/pet/processed/app.ico",
    "target": [{ "target": "portable", "arch": ["x64"] }]
  },
  "portable": {
    "artifactName": "MAOTAO-Win7-${version}-x64.exe"
  }
}
